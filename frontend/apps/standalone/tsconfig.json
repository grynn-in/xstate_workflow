{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@xstate-workflow/core": ["../../packages/core/src"],
      "@xstate-workflow/core/*": ["../../packages/core/src/*"],
      "@xstate-workflow/core-v2": ["../../packages/core-v2/src"],
      "@xstate-workflow/core-v2/*": ["../../packages/core-v2/src/*"],
      "@xstate-workflow/frappe-adapter": ["../../packages/frappe-adapter/src"],
      "@xstate-workflow/frappe-adapter/*": ["../../packages/frappe-adapter/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/core/src/**/*",
    "../../packages/core-v2/src/**/*",
    "../../packages/frappe-adapter/src/**/*"
  ]
}
